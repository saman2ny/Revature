# Copy to secrets.yaml, fill in real values, and NEVER commit the filled-in version.
# Apply with: kubectl apply -f infra/k8s/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: fleetai-secrets
  namespace: fleet-ai
type: Opaque
stringData:
  POSTGRES_PASSWORD: "change-me"
  JWT_SECRET: "change-me-change-me-change-me-change-me"
  ANTHROPIC_API_KEY: "sk-ant-xxxxxxxx"
  MINIO_ROOT_USER: "fleetai"
  MINIO_ROOT_PASSWORD: "change-me"
